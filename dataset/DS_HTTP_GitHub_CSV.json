{
    "name": "DS_HTTP_GitHub_CSV",
    "properties": {
        "description": "Parameterized HTTP dataset. Resolves to https://raw.githubusercontent.com/JerBouma/FinanceDatabase/main/database/{asset_folder}/{exchange_code}.csv",
        "linkedServiceName": {
            "referenceName": "LS_HTTP_GitHub",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "asset_folder": {
                "type": "String",
                "description": "GitHub subfolder — one of: equities, etfs, funds"
            },
            "exchange_code": {
                "type": "String",
                "description": "Exchange code without extension, e.g. BER, LSE, NYQ"
            }
        },
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "HttpServerLocation",
                "relativeUrl": {
                    "value": "@concat('/JerBouma/FinanceDatabase/main/database/', dataset().asset_folder, '/', dataset().exchange_code, '.csv')",
                    "type": "Expression"
                }
            },
            "columnDelimiter": ",",
            "rowDelimiter": "\n",
            "encodingName": "UTF-8",
            "escapeChar": "\\",
            "quoteChar": "\"",
            "firstRowAsHeader": true
        },
        "schema": [],
        "annotations": [
            "source:github",
            "project:financial-universe-control-tower"
        ]
    }
}
