{
	"name": "PL_Metadata_Driven_Ingestion",
	"properties": {
		"description": "Metadata-driven ingestion pipeline to dynamically process active financial datasets into ADLS Gen2 Bronze layer",
		"activities": [
			{
				"name": "Lookup_Active_Datasets",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						}
					},
					"dataset": {
						"referenceName": "DS_GitHub_HTTP_CSV",
						"type": "DatasetReference",
						"parameters": {
							"relativeUrl": "resources/dataset_metadata.json"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Active_Dataset",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Active_Datasets",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Active_Datasets').output.value",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 5,
					"activities": [
						{
							"name": "Copy_CSV_To_Bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.01:00:00",
								"retry": 3,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "Source",
									"value": "@item().source_path"
								},
								{
									"name": "Destination",
									"value": "bronze/@{item().target_folder}/snapshot_date=@{pipeline().parameters.snapshotDate}/@{item().file_name}"
								}
							],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "HttpReadSettings",
										"requestMethod": "GET"
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									},
									"additionalColumns": [
										{
											"name": "ingestion_timestamp",
											"value": "$$PAYLOAD:utcnow()"
										},
										{
											"name": "pipeline_run_id",
											"value": "$$PAYLOAD:pipeline().RunId"
										},
										{
											"name": "source_url",
											"value": "$$PAYLOAD:item().source_path"
										},
										{
											"name": "snapshot_date",
											"value": "$$PAYLOAD:pipeline().parameters.snapshotDate"
										}
									]
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".csv"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_GitHub_HTTP_CSV",
									"type": "DatasetReference",
									"parameters": {
										"relativeUrl": "@item().source_path"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ADLS_Bronze_CSV",
									"type": "DatasetReference",
									"parameters": {
										"container": "destination",
										"folderPath": "@concat('bronze/', item().target_folder, '/snapshot_date=', pipeline().parameters.snapshotDate)",
										"fileName": "@item().file_name"
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"snapshotDate": {
				"type": "string",
				"defaultValue": "@formatDateTime(utcnow(), 'yyyy-MM-dd')"
			}
		},
		"annotations": ["Ingestion", "Metadata-Driven", "Bronze"]
	}
}
