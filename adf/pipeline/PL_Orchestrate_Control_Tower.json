{
	"name": "PL_Orchestrate_Control_Tower",
	"properties": {
		"description": "Master orchestration pipeline triggering ingestion and Databricks PySpark transformation notebooks for the Financial Universe Control Tower",
		"activities": [
			{
				"name": "Execute_Ingestion_Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Metadata_Driven_Ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"snapshotDate": "@pipeline().parameters.snapshotDate"
					}
				}
			},
			{
				"name": "Databricks_00_Setup",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Execute_Ingestion_Pipeline",
						"dependencyConditions": ["Succeeded"]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/00_setup",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Databricks_01_Source_Profiling",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Databricks_00_Setup",
						"dependencyConditions": ["Succeeded"]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/01_source_profiling",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Databricks_02_Bronze_Ingestion",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Databricks_01_Source_Profiling",
						"dependencyConditions": ["Succeeded"]
					}
				],
				"policy": {
					"timeout": "0.00:45:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/02_bronze_ingestion",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Databricks_03_Schema_Standardization",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Databricks_02_Bronze_Ingestion",
						"dependencyConditions": ["Succeeded"]
					}
				],
				"policy": {
					"timeout": "0.00:45:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/03_schema_standardization",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Databricks_04_Master_Data",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Databricks_03_Schema_Standardization",
						"dependencyConditions": ["Succeeded"]
					}
				],
				"policy": {
					"timeout": "0.01:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/04_master_data",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Databricks_05_Data_Quality",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Databricks_04_Master_Data",
						"dependencyConditions": ["Succeeded"]
					}
				],
				"policy": {
					"timeout": "0.00:45:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/05_data_quality",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Databricks_06_Change_Detection",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Databricks_05_Data_Quality",
						"dependencyConditions": ["Succeeded"]
					}
				],
				"policy": {
					"timeout": "0.01:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/06_change_detection",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Databricks_07_Gold_Processing",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Databricks_06_Change_Detection",
						"dependencyConditions": ["Succeeded"]
					}
				],
				"policy": {
					"timeout": "0.00:45:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/07_gold_processing",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Databricks_08_SQL_Views",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Databricks_07_Gold_Processing",
						"dependencyConditions": ["Succeeded"]
					}
				],
				"policy": {
					"timeout": "0.00:30:00",
					"retry": 2,
					"retryIntervalInSeconds": 30
				},
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/08_sql_views",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"snapshotDate": {
				"type": "string",
				"defaultValue": "@formatDateTime(utcnow(), 'yyyy-MM-dd')"
			},
			"environment": {
				"type": "string",
				"defaultValue": "dev"
			}
		},
		"annotations": ["Master", "Orchestration", "ControlTower"]
	}
}
