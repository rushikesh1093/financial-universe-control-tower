{
	"name": "PL_Orchestrate_Control_Tower",
	"properties": {
		"description": "Master orchestration pipeline in Azure Data Factory. Ingests raw source data into ADLS Gen2 Bronze, then triggers the Databricks transformation workflow pipeline.",
		"activities": [
			{
				"name": "Execute_Ingestion_Pipeline",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Metadata_Driven_Ingestion",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"snapshotDate": "@pipeline().parameters.snapshotDate"
					}
				}
			},
			{
				"name": "Databricks_Transformation_Pipeline",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Execute_Ingestion_Pipeline",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.02:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/databricks/notebooks/00_setup.ipynb",
					"baseParameters": {
						"snapshot_date": "@pipeline().parameters.snapshotDate",
						"run_full_pipeline": "true"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_AzureDatabricks",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"snapshotDate": {
				"type": "string",
				"defaultValue": "@formatDateTime(utcnow(), 'yyyy-MM-dd')"
			},
			"environment": {
				"type": "string",
				"defaultValue": "dev"
			}
		},
		"annotations": ["Master", "Orchestration", "ControlTower", "DatabricksJob"]
	}
}
