{
	"name": "DS_ADLS_Bronze_CSV",
	"type": "Microsoft.DataFactory/factories/datasets",
	"properties": {
		"description": "Parameterized ADLS Gen2 DelimitedText dataset targeting Bronze point-in-time snapshot directories",
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"container": {
				"type": "string",
				"defaultValue": "destination"
			},
			"folderPath": {
				"type": "string"
			},
			"fileName": {
				"type": "string"
			}
		},
		"annotations": ["ADLS", "Bronze", "Target"],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileSystem": "@dataset().container",
				"folderPath": "@dataset().folderPath",
				"fileName": "@dataset().fileName"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}
