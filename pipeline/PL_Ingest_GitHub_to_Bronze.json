/funds_data\",\"exchange_code\":\"MCE\"},{\"asset_folder\":\"funds\",\"bronze_folder\":\"bronze/funds_data\",\"exchange_code\":\"NAS\"},{\"asset_folder\":\"funds\",\"bronze_folder\":\"bronze/funds_data\",\"exchange_code\":\"TOR\"},{\"asset_folder\":\"funds\",\"bronze_folder\":\"bronze/funds_data\",\"exchange_code\":\"MEX\"},{\"asset_folder\":\"funds\",\"bronze_folder\":\"bronze/funds_data\",\"exchange_code\":\"STU\"}]')",
                        "type": "Expression"
                    },
                    "activities": [
