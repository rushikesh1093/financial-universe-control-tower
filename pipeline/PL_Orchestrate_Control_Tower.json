{
	"name": "PL_Orchestrate_Control_Tower",
	"properties": {
		"description": "Master pipeline — Step 1: copy CSVs from GitHub to bronze (ADLS). Step 2: trigger Databricks workflow job.",
		"activities": [
			{
				"name": "Step1_Ingest_GitHub_to_Bronze",
				"description": "Download all ETF, equity and fund CSVs from GitHub into ADLS bronze folders.",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Ingest_GitHub_to_Bronze",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"snapshot_date": {
							"value": "@pipeline().parameters.snapshot_date",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Step2_Run_Databricks_Job",
				"description": "Trigger the Financial Universe Control Tower Databricks workflow job.",
				"type": "DatabricksJob",
				"dependsOn": [
					{
						"activity": "Step1_Ingest_GitHub_to_Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.08:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 60
				},
				"userProperties": [],
				"typeProperties": {
					"jobParameters": {
						"snapshot_date": {
							"value": "@pipeline().parameters.snapshot_date",
							"type": "Expression"
						},
						"catalog": "azurelearn",
						"source_root": "abfss://destination@learnazure11.dfs.core.windows.net/bronze",
						"silver_root": "abfss://destination@learnazure11.dfs.core.windows.net/silver",
						"gold_root": "abfss://destination@learnazure11.dfs.core.windows.net/gold",
						"quarantine_root": "abfss://destination@learnazure11.dfs.core.windows.net/quarantine",
						"reprocess": "false"
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_Databricks",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"snapshot_date": {
				"type": "String",
				"defaultValue": "@formatDateTime(utcNow(), 'yyyy-MM-dd')"
			}
		},
		"folder": {
			"name": "FinancialUniverse"
		},
		"annotations": []
	}
}